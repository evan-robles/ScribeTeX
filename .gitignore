__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# macOS
.DS_Store
**/.DS_Store

# Xcode — the .xcodeproj is generated by xcodegen; keep project.pbxproj tracked
# (needed to build) but ignore per-user IDE state that changes on every open.
**/xcuserdata/
**/*.xcuserstate
**/project.xcworkspace/xcuserdata/
**/project.xcworkspace/contents.xcworkspacedata

# stray chem/assay run artifacts (from unrelated assay MCP runs)
*.molden
*.cube
*_orbitals_*.json
*_build.json
build_*.out
orbitals_*.out
input_configs.yaml
.superpowers/
